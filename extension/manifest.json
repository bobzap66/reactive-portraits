{
  "manifest_version": 3,
  "name": "Reactive Portraits — Foundry Bridge",
  "version": "1.2.0",
  "description": "Send approved GM Stream Director data to your local Reactive Portraits server.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
